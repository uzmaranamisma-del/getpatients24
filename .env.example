# Public site URL (used for SEO metadata and sitemap)
NEXT_PUBLIC_SITE_URL=https://getpatients24.com

# ---- Form emails (every website form is emailed here) ----
LEAD_TO_EMAIL=getpatients24@gmail.com
# Gmail account that sends the emails, and its 16-character App Password
# (Google Account > Security > 2-Step Verification > App passwords). Not your normal password.
SMTP_USER=getpatients24@gmail.com
SMTP_PASS=
# Defaults for Gmail; change only if you use another mail provider
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Optional: also forward each lead as JSON to n8n / Make / Zapier / a CRM
LEAD_WEBHOOK_URL=

